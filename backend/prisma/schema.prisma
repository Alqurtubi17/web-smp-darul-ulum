// This is your Prisma schema file
// SMP Darul Ulum Surabaya — Full Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUM ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  GURU
  SISWA
  ORANG_TUA
  PENGUNJUNG
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AdmissionStatus {
  PENDING
  VERIFIKASI
  LULUS
  DITOLAK
  DAFTAR_ULANG
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum GradeType {
  TUGAS
  ULANGAN_HARIAN
  UTS
  UAS
  PRAKTIK
}

enum PaymentType {
  SPP
  UANG_GEDUNG
  KEGIATAN
  DENDA_BUKU
  LAINNYA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  TUNAI
  TRANSFER
}

enum BorrowingStatus {
  DIPINJAM
  DIKEMBALIKAN
  TERLAMBAT
  HILANG
}

enum NotificationType {
  NILAI
  ABSENSI
  TUGAS
  PENGUMUMAN
  PPDB
  PEMBAYARAN
  UMUM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GalleryType {
  FOTO
  VIDEO
}

enum AssignmentStatus {
  AKTIF
  DITUTUP
}

enum SubmissionStatus {
  BELUM_SUBMIT
  SUBMITTED
  DINILAI
  TERLAMBAT
}

// ─── USERS & AUTH ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  role          Role      @default(PENGUNJUNG)
  isActive      Boolean   @default(true)
  isEmailVerified Boolean @default(false)
  lastLogin     DateTime?
  refreshToken  String?
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student?
  teacher       Teacher?
  parent        Parent?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ─── STUDENTS ─────────────────────────────────────────────────────────────

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  nis           String    @unique  // Nomor Induk Siswa
  nisn          String?   @unique  // Nomor Induk Siswa Nasional
  fullName      String
  nickname      String?
  gender        Gender
  birthPlace    String?
  birthDate     DateTime?
  address       String?
  phone         String?
  photo         String?   // URL foto
  classId       String?
  parentId      String?
  enrolledAt    DateTime  @default(now())
  graduatedAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class         Class?    @relation(fields: [classId], references: [id])
  parent        Parent?   @relation(fields: [parentId], references: [id])
  attendances   Attendance[]
  grades        Grade[]
  submissions   AssignmentSubmission[]
  borrowings    Borrowing[]
  payments      Payment[]
  qrCodes       StudentQRCode[]

  @@map("students")
}

model StudentQRCode {
  id          String   @id @default(uuid())
  studentId   String
  code        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id])

  @@map("student_qr_codes")
}

// ─── TEACHERS ─────────────────────────────────────────────────────────────

model Teacher {
  id            String    @id @default(uuid())
  userId        String    @unique
  nip           String?   @unique  // Nomor Induk Pegawai
  fullName      String
  gender        Gender
  birthPlace    String?
  birthDate     DateTime?
  address       String?
  phone         String?
  photo         String?
  subject       String?   // Mata pelajaran utama
  education     String?   // Pendidikan terakhir
  joinedAt      DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules     Schedule[]
  attendances   Attendance[]
  grades        Grade[]
  assignments   Assignment[]
  materials     Material[]
  announcements ClassAnnouncement[]

  @@map("teachers")
}

// ─── PARENTS ──────────────────────────────────────────────────────────────

model Parent {
  id            String    @id @default(uuid())
  userId        String    @unique
  fullName      String
  gender        Gender?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  occupation    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      Student[]

  @@map("parents")
}

// ─── CLASSES & SUBJECTS ───────────────────────────────────────────────────

model Class {
  id            String    @id @default(uuid())
  name          String    // "7A", "8B", "9C"
  grade         Int       // 7, 8, 9
  academicYear  String    // "2024/2025"
  homeroomTeacherId String?
  capacity      Int       @default(32)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  students      Student[]
  schedules     Schedule[]
  attendances   Attendance[]
  announcements ClassAnnouncement[]

  @@map("classes")
}

model Subject {
  id            String    @id @default(uuid())
  code          String    @unique  // "MTK", "BIN", "IPA"
  name          String    // "Matematika", "Bahasa Indonesia"
  grade         Int?      // 7/8/9, null = semua
  creditHours   Int       @default(2)
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  schedules     Schedule[]
  grades        Grade[]
  assignments   Assignment[]
  materials     Material[]

  @@map("subjects")
}

model Schedule {
  id            String    @id @default(uuid())
  classId       String
  subjectId     String
  teacherId     String
  dayOfWeek     Int       // 1=Senin, 2=Selasa, ..., 5=Jumat, 6=Sabtu
  startTime     String    // "07:00"
  endTime       String    // "08:40"
  room          String?
  academicYear  String
  semester      Int       // 1 atau 2
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  class         Class     @relation(fields: [classId], references: [id])
  subject       Subject   @relation(fields: [subjectId], references: [id])
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  attendances   Attendance[]

  @@map("schedules")
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────

model Attendance {
  id            String          @id @default(uuid())
  studentId     String
  scheduleId    String?
  classId       String?
  teacherId     String?
  date          DateTime
  status        AttendanceStatus @default(HADIR)
  notes         String?
  method        String?         // "manual", "qr_code"
  academicYear  String
  semester      Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student       Student         @relation(fields: [studentId], references: [id])
  schedule      Schedule?       @relation(fields: [scheduleId], references: [id])
  class         Class?          @relation(fields: [classId], references: [id])
  teacher       Teacher?        @relation(fields: [teacherId], references: [id])

  @@unique([studentId, scheduleId, date])
  @@map("attendances")
}

// ─── GRADES ───────────────────────────────────────────────────────────────

model Grade {
  id            String    @id @default(uuid())
  studentId     String
  subjectId     String
  teacherId     String
  type          GradeType
  score         Float
  maxScore      Float     @default(100)
  weight        Float     @default(1)  // bobot nilai
  title         String?
  notes         String?
  academicYear  String
  semester      Int
  gradedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student   @relation(fields: [studentId], references: [id])
  subject       Subject   @relation(fields: [subjectId], references: [id])
  teacher       Teacher   @relation(fields: [teacherId], references: [id])

  @@map("grades")
}

// ─── ASSIGNMENTS ──────────────────────────────────────────────────────────

model Assignment {
  id            String          @id @default(uuid())
  teacherId     String
  subjectId     String
  classId       String?
  title         String
  description   String?
  fileUrl       String?         // URL file soal
  dueDate       DateTime
  maxScore      Float           @default(100)
  status        AssignmentStatus @default(AKTIF)
  academicYear  String
  semester      Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  teacher       Teacher         @relation(fields: [teacherId], references: [id])
  subject       Subject         @relation(fields: [subjectId], references: [id])
  submissions   AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id            String          @id @default(uuid())
  assignmentId  String
  studentId     String
  fileUrl       String?
  content       String?
  score         Float?
  feedback      String?
  status        SubmissionStatus @default(BELUM_SUBMIT)
  submittedAt   DateTime?
  gradedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assignment    Assignment      @relation(fields: [assignmentId], references: [id])
  student       Student         @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// ─── MATERIALS ────────────────────────────────────────────────────────────

model Material {
  id            String    @id @default(uuid())
  teacherId     String
  subjectId     String
  classId       String?
  title         String
  description   String?
  fileUrl       String?
  externalUrl   String?
  type          String    @default("document") // document, video, link
  academicYear  String
  semester      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  subject       Subject   @relation(fields: [subjectId], references: [id])

  @@map("materials")
}

// ─── NEWS & ANNOUNCEMENTS ─────────────────────────────────────────────────

model News {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  thumbnail     String?
  category      String?
  tags          String[]
  status        NewsStatus @default(DRAFT)
  viewCount     Int       @default(0)
  authorId      String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("news")
}

model Announcement {
  id            String    @id @default(uuid())
  title         String
  content       String
  fileUrl       String?
  targetRoles   Role[]
  isPinned      Boolean   @default(false)
  isActive      Boolean   @default(true)
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?
  authorId      String?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("announcements")
}

model ClassAnnouncement {
  id            String    @id @default(uuid())
  teacherId     String
  classId       String
  title         String
  content       String
  fileUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  class         Class     @relation(fields: [classId], references: [id])

  @@map("class_announcements")
}

// ─── EVENTS ───────────────────────────────────────────────────────────────

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String?
  location      String?
  thumbnail     String?
  startDate     DateTime
  endDate       DateTime?
  isAllDay      Boolean   @default(false)
  category      String?
  isPublic      Boolean   @default(true)
  authorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("events")
}

// ─── GALLERY ──────────────────────────────────────────────────────────────

model GalleryAlbum {
  id            String    @id @default(uuid())
  title         String
  description   String?
  cover         String?
  type          GalleryType @default(FOTO)
  isPublic      Boolean   @default(true)
  authorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         GalleryItem[]

  @@map("gallery_albums")
}

model GalleryItem {
  id            String    @id @default(uuid())
  albumId       String
  url           String
  thumbnail     String?
  caption       String?
  type          GalleryType @default(FOTO)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  album         GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("gallery_items")
}

// ─── ACHIEVEMENT & DOWNLOAD ───────────────────────────────────────────────

model Achievement {
  id            String    @id @default(uuid())
  title         String
  description   String?
  category      String    // "siswa", "guru", "sekolah"
  level         String?   // "kabupaten", "provinsi", "nasional", "internasional"
  year          Int
  winner        String?
  photo         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@map("achievements")
}


model Download {
  id            String    @id @default(uuid())
  title         String
  description   String?
  fileUrl       String
  category      String    // "formulir", "dokumen", "panduan"
  downloadCount Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("downloads")
}

// ─── PPDB / ADMISSIONS ────────────────────────────────────────────────────

model Admission {
  id            String          @id @default(uuid())
  registrationNumber String     @unique  // nomor pendaftaran
  academicYear  String
  fullName      String
  gender        Gender
  birthPlace    String
  birthDate     DateTime
  address       String
  phone         String?
  parentName    String
  parentPhone   String
  parentEmail   String?
  previousSchool String?
  graduationYear Int?
  
  // Upload berkas
  photoUrl      String?
  ijazahUrl     String?
  skhunUrl      String?
  aktaUrl       String?
  kkUrl         String?
  
  status        AdmissionStatus @default(PENDING)
  score         Float?          // nilai seleksi
  notes         String?         // catatan admin
  rejectionReason String?
  
  reviewedBy    String?
  reviewedAt    DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("admissions")
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid())
  studentId       String
  type            PaymentType
  amount          Float
  dueDate         DateTime?
  paidAt          DateTime?
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod?
  transactionId   String?       // dari payment gateway
  receiptUrl      String?
  notes           String?
  month           Int?          // untuk SPP: bulan ke-
  year            Int?          // untuk SPP: tahun
  academicYear    String
  processedBy     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student         Student       @relation(fields: [studentId], references: [id])

  @@map("payments")
}

// ─── LIBRARY ──────────────────────────────────────────────────────────────

model Book {
  id            String    @id @default(uuid())
  isbn          String?   @unique
  title         String
  author        String
  publisher     String?
  year          Int?
  category      String?
  description   String?
  cover         String?
  totalStock    Int       @default(1)
  availableStock Int      @default(1)
  location      String?   // rak buku
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  borrowings    Borrowing[]

  @@map("books")
}

model Borrowing {
  id            String          @id @default(uuid())
  bookId        String
  studentId     String
  borrowedAt    DateTime        @default(now())
  dueDate       DateTime
  returnedAt    DateTime?
  status        BorrowingStatus @default(DIPINJAM)
  fineAmount    Float?
  finePaid      Boolean         @default(false)
  notes         String?
  processedBy   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  book          Book            @relation(fields: [bookId], references: [id])
  student       Student         @relation(fields: [studentId], references: [id])

  @@map("borrowings")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────

model Notification {
  id            String              @id @default(uuid())
  userId        String
  type          NotificationType
  channel       NotificationChannel @default(IN_APP)
  title         String
  message       String
  data          Json?               // data tambahan (link, id referensi)
  isRead        Boolean             @default(false)
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  action        String    // "CREATE", "UPDATE", "DELETE", "LOGIN"
  resource      String    // "news", "student", "payment"
  resourceId    String?
  oldData       Json?
  newData       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── SITE SETTINGS ────────────────────────────────────────────────────────

model SiteSetting {
  id            String    @id @default(uuid())
  key           String    @unique
  value         String
  type          String    @default("text")  // text, json, boolean, image
  group         String    @default("general")
  label         String?
  updatedAt     DateTime  @updatedAt

  @@map("site_settings")
}

// ─── ACADEMIC YEARS ───────────────────────────────────────────────────────

model AcademicYear {
  id          String    @id @default(uuid())
  year        String    // "2024/2025"
  semester    String    // "Ganjil" or "Genap"
  isActive    Boolean   @default(false)
  status      String    @default("Mendatang") // "Aktif", "Arsip", "Mendatang"
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("academic_years")
}

